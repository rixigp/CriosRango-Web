{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "cr-green", "name": "Verde Críos & Rango", "color": "#355f4b" },
        { "slug": "cr-green-dark", "name": "Verde oscuro", "color": "#244436" },
        { "slug": "cr-cream", "name": "Crema", "color": "#f7f3eb" },
        { "slug": "cr-sand", "name": "Arena", "color": "#ebe2d4" },
        { "slug": "cr-blush", "name": "Rosa suave", "color": "#f3e6e4" },
        { "slug": "cr-blue", "name": "Azul suave", "color": "#e5edf1" },
        { "slug": "cr-ink", "name": "Texto", "color": "#20241f" },
        { "slug": "cr-muted", "name": "Texto secundario", "color": "#71766f" },
        { "slug": "white", "name": "Blanco", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "XS", "size": "0.5rem" },
        { "slug": "20", "name": "S", "size": "0.75rem" },
        { "slug": "30", "name": "M", "size": "1rem" },
        { "slug": "40", "name": "L", "size": "1.5rem" },
        { "slug": "50", "name": "XL", "size": "2rem" },
        { "slug": "60", "name": "2XL", "size": "3rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "Sistema",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Pequeño", "size": "0.875rem" },
        { "slug": "medium", "name": "Normal", "size": "1rem" },
        { "slug": "large", "name": "Grande", "size": "1.25rem" },
        { "slug": "x-large", "name": "XL", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.2rem, 5vw, 4.6rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f7f3eb",
      "text": "#20241f"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": { "text": "#355f4b" },
        ":hover": { "color": { "text": "#244436" } }
      },
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "#355f4b", "text": "#ffffff" },
        "typography": { "fontWeight": "700" }
      }
    }
  }
}
